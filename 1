Practical 04, Part C — session_lab_server.py
#!/usr/bin/env python3
"""Deliberately simple local session-lab web server.

For isolated classroom use only. It supports two modes:
 * HTTP (insecure cookie attributes) for observing session exposure.
 * HTTPS (Secure/HttpOnly/SameSite cookie + HSTS header) for comparison.
"""

from __future__ import annotations

import argparse
import html
import http.cookies
import http.server
import secrets
import ssl
import urllib.parse
from typing import Dict

SESSIONS: Dict[str, str] = {}
USERNAME = "student"
PASSWORD = "lab123"


class SessionLabHandler(http.server.BaseHTTPRequestHandler):
    server_version = "SessionLab/1.0"

    def _send(self, status: int, body: str, *, content_type: str = "text/html; charset=utf-8", headers=None):
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        if getattr(self.server, "secure_mode", False):
            self.send_header("Strict-Transport-Security", "max-age=300")
        if headers:
            for key, value in headers:
                self.send_header(key, value)
        self.end_headers()
        self.wfile.write(data)

    def _session_user(self):
        raw = self.headers.get("Cookie", "")
        jar = http.cookies.SimpleCookie()
        try:
            jar.load(raw)
        except http.cookies.CookieError:
            return None
        morsel = jar.get("LABSESSID")
        if not morsel:
            return None
        return SESSIONS.get(morsel.value)

    def do_GET(self):
        path = urllib.parse.urlsplit(self.path).path
        if path == "/":
            user = self._session_user()
            if user:
                body = f"""<!doctype html><title>Session Lab</title>
                <h1>Session Lab</h1><p>Logged in as <b>{html.escape(user)}</b>.</p>
                <p><a href='/account'>Open account page</a> | <a href='/logout'>Logout</a></p>"""
            else:
                scheme = "HTTPS" if getattr(self.server, "secure_mode", False) else "HTTP"
                body = f"""<!doctype html><title>Session Lab</title>
                <h1>Session Lab - {scheme}</h1>
                <p>Dummy classroom credentials: <code>{USERNAME}</code> / <code>{PASSWORD}</code></p>
                <form method='post' action='/login'>
                 <label>Username <input name='username'></label><br>
                 <label>Password <input name='password' type='password'></label><br>
                 <button type='submit'>Login</button>
                </form>"""
            self._send(200, body)
            return

        if path == "/account":
            user = self._session_user()
            if not user:
                self._send(401, "Not authenticated\n", content_type="text/plain; charset=utf-8")
                return
            self._send(200, f"Authenticated session for {user}\n", content_type="text/plain; charset=utf-8")
            return

        if path == "/logout":
            raw = self.headers.get("Cookie", "")
            jar = http.cookies.SimpleCookie()
            try:
                jar.load(raw)
                morsel = jar.get("LABSESSID")
                if morsel:
                    SESSIONS.pop(morsel.value, None)
            except http.cookies.CookieError:
                pass
            attrs = "Path=/; Max-Age=0; SameSite=Lax"
            if getattr(self.server, "secure_mode", False):
                attrs += "; Secure; HttpOnly"
            self._send(200, "Logged out\n", content_type="text/plain; charset=utf-8",
                       headers=[("Set-Cookie", f"LABSESSID=deleted; {attrs}")])
            return

        self._send(404, "Not found\n", content_type="text/plain; charset=utf-8")

    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if path != "/login":
            self._send(404, "Not found\n", content_type="text/plain; charset=utf-8")
            return

        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length).decode("utf-8", errors="replace")
        form = urllib.parse.parse_qs(body, keep_blank_values=True)
        username = form.get("username", [""])[0]
        password = form.get("password", [""])[0]
        if username != USERNAME or password != PASSWORD:
            self._send(403, "Invalid lab credentials\n", content_type="text/plain; charset=utf-8")
            return

        token = secrets.token_hex(16)
        SESSIONS[token] = username
        attrs = "Path=/; SameSite=Lax"
        if getattr(self.server, "secure_mode", False):
            attrs += "; Secure; HttpOnly"
        headers = [
            ("Set-Cookie", f"LABSESSID={token}; {attrs}"),
            ("Location", "/account"),
        ]
        self._send(302, "Login successful\n", content_type="text/plain; charset=utf-8", headers=headers)

    def log_message(self, fmt, *args):
        print(f"[{self.address_string()}] {fmt % args}")


def main():
    parser = argparse.ArgumentParser(description="Local isolated session-hijacking teaching server")
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=8000)
    parser.add_argument("--https", action="store_true", help="Enable TLS and secure cookie attributes")
    parser.add_argument("--cert", help="Server certificate PEM for --https")
    parser.add_argument("--key", help="Server private key PEM for --https")
    args = parser.parse_args()

    if args.https and (not args.cert or not args.key):
        parser.error("--https requires --cert and --key")

    server = http.server.ThreadingHTTPServer((args.host, args.port), SessionLabHandler)
    server.secure_mode = args.https

    scheme = "https" if args.https else "http"
    if args.https:
        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        context.load_cert_chain(certfile=args.cert, keyfile=args.key)
        server.socket = context.wrap_socket(server.socket, server_side=True)

    print(f"Session Lab server listening on {scheme}://{args.host}:{args.port}")
    print(f"Dummy credentials: {USERNAME} / {PASSWORD}")
    print("Press Ctrl+C to stop.")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopping server.")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
