#!/usr/bin/env python3
import argparse
import random
import sys
import re
from pathlib import Path
from urllib.parse import parse_qs, urlparse

import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.dummy import DummyClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (accuracy_score, classification_report, confusion_matrix,
                              ConfusionMatrixDisplay, precision_recall_fscore_support,
                              roc_auc_score)
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

BASE = Path(__file__).resolve().parent
DATA = BASE / "datasets"
OUT = BASE / "outputs"
SEED = 42
URL_COLS = ["url_length", "dots", "hyphens", "digits", "at_sign", "https",
            "path_depth", "keyword_count", "query_params", "ip_host"]
KEYWORDS = ["login", "verify", "update", "secure", "account", "billing", "reset"]


def ensure_dirs():
    DATA.mkdir(parents=True, exist_ok=True)
    OUT.mkdir(parents=True, exist_ok=True)


def build_urls():
    rng = random.Random(SEED)
    words = ["atlas", "cedar", "harbor", "lotus", "river", "willow", "metro"]
    brands = ["alpha", "beta", "gamma", "delta"]
    common = ["products", "support", "catalog", "about", "contact"]
    records = []
    for _ in range(400):
        b, w, n = rng.choice(words), rng.choice(brands), rng.randint(100, 9999)
        base_styles = [
            f"https://{w}.example.text/{rng.choice(common)}",
            f"http://{w}.example.text/index.html",
            f"http://{w}.{b}.example.text/catalog/item/{n}",
            f"https://service.{w}.text/contact",
            f"https://{b}.example.text/login",
            f"https://{w}.text/account"
        ]
        records.append((rng.choice(base_styles), 0))
    for _ in range(400):
        b, w, n = rng.choice(words), rng.choice(brands), rng.randint(100, 9999)
        suspect_styles = [
            f"http://192.168.1.50/verify-account",
            f"http://{rng.randint(100,999)}.{rng.randint(1,255)}.org/login",
            f"http://{w}-verify-{n}.account-test/login?ref={n}",
            f"https://secure-{b}-{n}.account-test/update/password",
            f"http://{b}-check-{n}.test/billing/verify?user={n}",
            f"https://account-support-test/session/{n}",
            f"http://support-{b}.test/login",
            f"https://portal-{b}.test/verify"
        ]
        records.append((rng.choice(suspect_styles), 1))
    rng.shuffle(records)
    return pd.DataFrame(records, columns=["url", "label"])


def url_features(url):
    parsed = urlparse(url)
    host = parsed.netloc
    path = parsed.path
    return [
        len(url),
        url.count("."),
        url.count("-"),
        sum(c.isdigit() for c in url),
        int("@" in url),
        int(parsed.scheme.lower() == "https"),
        len([p for p in path.split("/") if p]),
        sum(k in url.lower() for k in KEYWORDS),
        len(parse_qs(parsed.query)),
        int(bool(re.fullmatch(r"(?:\d{1,3}\.){3}\d{1,3}", host)))
    ]


def supervised():
    ensure_dirs()
    df = pd.read_csv(DATA / "urls_synthetic.csv")
    X = pd.DataFrame([url_features(u) for u in df["url"]], columns=URL_COLS)
    y = df["label"].astype(int)
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.25, random_state=SEED, stratify=y)
    baseline = DummyClassifier(strategy="most_frequent").fit(X_train, y_train)
    model = make_pipeline(StandardScaler(),
                           LogisticRegression(max_iter=1000, random_state=SEED))
    model.fit(X_train, y_train)
    pred_base = baseline.predict(X_test)
    predicted = model.predict(X_test)
    probs = model.predict_proba(X_test)[:, 1]
    base_acc = accuracy_score(y_test, pred_base)
    acc = accuracy_score(y_test, predicted)
    prec, rec, f1, _ = precision_recall_fscore_support(y_test, predicted, average="binary")
    auc = roc_auc_score(y_test, probs)
    print(f"[SUPERVISED] train {len(X_train)} test {len(X_test)} "
          f"(100 benign, 100 suspicious)")
    print(f"[SUPERVISED] baseline accuracy {base_acc:.3f}")
    print(f"[SUPERVISED] accuracy {acc:.3f} precision {prec:.3f} "
          f"recall {rec:.3f} f1 {f1:.3f} auc {auc:.3f}")
    cm = confusion_matrix(y_test, predicted)
    print("[SUPERVISED] confusion matrix [[TN FP], [FN TP]]:")
    print(f"[[{cm[0][0]} {cm[0][1]}]]")
    print(f"[[{cm[1][0]} {cm[1][1]}]]")

    examples = [
        "https://atlas.example.text/about",
        "http://alpha-verify-1234.account-test/login?ref=1234",
        "https://beta.example.text/reset-password"
    ]
    feats = pd.DataFrame([url_features(u) for u in examples], columns=URL_COLS)
    ex_probs = model.predict_proba(feats)[:, 1]
    for u, p in zip(examples, ex_probs):
        lbl = "suspicious" if p >= 0.5 else "benign"
        print(f"[{'SUSP' if lbl=='suspicious' else 'BENIGN'}] P({lbl}) {p:.3f} {u}")

    ConfusionMatrixDisplay.from_predictions(y_test, predicted,
                                             display_labels=["benign", "suspicious"])
    plt.title("Synthetic URL classification: test confusion matrix")
    plt.tight_layout()
    plt.savefig(OUT / "url_confusion.png", dpi=100)
    plt.close()

    res = pd.DataFrame({"true_label": y_test.to_numpy(), "pred_label": predicted,
                         "suspicious_score": probs})
    res.to_csv(OUT / "url_test_predictions.csv", index=False)


def generate():
    ensure_dirs()
    df = build_urls()
    df.to_csv(DATA / "urls_synthetic.csv", index=False)
    print(f"[GENERATE] urls 800 (400 benign, 400 suspicious)")
    print(f"[GENERATE] saved synthetic CSV in datasets/")


def main():
    parser = argparse.ArgumentParser(description="offline synthetic ML for cybersecurity lab")
    parser.add_argument("stage", choices=["generate", "run", "all"],
                         help="generate dataset, train/evaluate, or do both")
    args = parser.parse_args()

    if args.stage in ("generate", "all"):
        generate()
    if args.stage in ("run", "all"):
        if not (DATA / "urls_synthetic.csv").is_file():
            parser.error("missing dataset; run 'python phishing_url_lab.py generate'")
        supervised()
        print(f"[SAVED] visualization and CSV results in outputs/")


if __name__ == "__main__":
    main()
